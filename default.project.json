{
	"globIgnorePaths": [
		"**/_drafts/**"
	],
	"name": "kar_wash",
	"tree": {
		"$className": "DataModel",
		"Lighting": {},
		"ReplicatedFirst": {},
		"ReplicatedStorage": {
			"Packages": {
				"$path": "Packages"
			},
			"shared": {
				"$className": "Folder",
				"$ignoreUnknownInstances": false,
				"core": {
					"$className": "Folder",
					"$ignoreUnknownInstances": false,
					"utility": {
						"$ignoreUnknownInstances": false,
						"$path": {
							"optional": "src/core/utility"
						}
					}
				}
			}
		},
		"RobloxPluginGuiService": {},
		"ServerScriptService": {
			"server": {
				"$className": "Folder",
				"$ignoreUnknownInstances": false,
				"Server": {
					"$path": {
						"optional": "src/(startup)/Server.server.luau"
					}
				},
				"core": {
					"$ignoreUnknownInstances": false,
					"$path": {
						"optional": "src/core/server"
					}
				},
				"feature": {
					"$className": "Folder",
					"$ignoreUnknownInstances": false,
					"plot": {
						"$className": "Folder",
						"$ignoreUnknownInstances": false,
						"PlotService": {
							"$path": {
								"optional": "src/feature/plot/PlotServiceServer.luau"
							}
						},
						"builder": {
							"$ignoreUnknownInstances": false,
							"$path": {
								"optional": "src/feature/plot/builder"
							}
						},
						"class": {
							"$ignoreUnknownInstances": false,
							"$path": {
								"optional": "src/feature/plot/class"
							}
						},
						"modules": {
							"$ignoreUnknownInstances": false,
							"$path": {
								"optional": "src/feature/plot/modules"
							}
						}
					}
				}
			}
		},
		"ServerStorage": {},
		"SoundService": {},
		"StarterGui": {},
		"StarterPack": {},
		"StarterPlayer": {
			"StarterCharacterScripts": {},
			"StarterPlayerScripts": {
				"client": {
					"$className": "Folder",
					"$ignoreUnknownInstances": false,
					"Client": {
						"$path": {
							"optional": "src/(startup)/Client.client.luau"
						}
					},
					"core": {
						"$ignoreUnknownInstances": false,
						"$path": {
							"optional": "src/core/client"
						}
					}
				}
			}
		},
		"Workspace": {}
	}
}